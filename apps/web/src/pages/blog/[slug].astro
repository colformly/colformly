---
import Layout from '../../layouts/Layout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: {
      post,
      allPosts: posts,
    },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  allPosts: CollectionEntry<'blog'>[];
}

const { post, allPosts } = Astro.props;
const { Content } = await post.render();

const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug)
  .slice(0, 2);

const canonicalUrl = `https://colformly.edgecors.com/blog/${post.slug}`;
const heroImageUrl = post.data.heroImage.startsWith('http')
  ? post.data.heroImage
  : `https://colformly.edgecors.com${post.data.heroImage}`;

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishDate.toISOString(),
    dateModified: (post.data.updatedDate || post.data.publishDate).toISOString(),
    url: canonicalUrl,
    image: heroImageUrl,
    author: {
      '@type': 'Organization',
      name: post.data.author,
      jobTitle: post.data.authorRole,
      url: 'https://colformly.edgecors.com',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Colformly',
      url: 'https://colformly.edgecors.com',
      logo: {
        '@type': 'ImageObject',
        url: 'https://colformly.edgecors.com/favicon.svg',
      },
    },
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': canonicalUrl,
    },
    keywords: post.data.tags.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: post.data.faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: 'https://colformly.edgecors.com',
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Blog',
        item: 'https://colformly.edgecors.com/blog',
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: post.data.title,
        item: canonicalUrl,
      },
    ],
  },
];
---

<Layout
  title={`${post.data.title} — Colformly`}
  description={post.data.description}
  canonical={canonicalUrl}
  ogImage={heroImageUrl}
  ogType="article"
  surfaceClass="bg-[#F8F9FB] dark:bg-[#07090E]"
  structuredData={structuredData}
>
  {/* Reading Progress Bar */}
  <div
    id="reading-progress-bar"
    class="fixed top-0 left-0 h-1 bg-gradient-to-r from-teal-500 via-emerald-400 to-teal-600 z-[100] transition-all duration-75 w-0"
    aria-hidden="true"
  ></div>

  <main class="relative pt-24 md:pt-32 pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto overflow-hidden">
    {/* Ambient Glow */}
    <div
      class="fixed top-0 left-1/2 -translate-x-1/2 w-[900px] h-[350px] bg-gradient-to-b from-teal-500/10 via-teal-500/5 to-transparent blur-[140px] rounded-full pointer-events-none -z-10"
      aria-hidden="true"
    ></div>

    {/* Breadcrumbs Navigation */}
    <nav class="flex items-center gap-2 text-xs text-slate-500 dark:text-slate-400 mb-8 max-w-4xl" aria-label="Breadcrumb">
      <a href="/" class="hover:text-teal-600 dark:hover:text-teal-400 transition-colors">Home</a>
      <span class="text-slate-400 dark:text-slate-600">/</span>
      <a href="/blog" class="hover:text-teal-600 dark:hover:text-teal-400 transition-colors">Blog</a>
      <span class="text-slate-400 dark:text-slate-600">/</span>
      <span class="text-slate-700 dark:text-slate-300 font-medium truncate">{post.data.category}</span>
    </nav>

    {/* Header Article Info */}
    <header class="max-w-4xl mb-10">
      <div class="flex flex-wrap items-center gap-3 mb-5">
        <span class="px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-teal-500/10 text-teal-600 dark:text-teal-400 border border-teal-500/20">
          {post.data.category}
        </span>
        <span class="text-xs text-slate-400 dark:text-slate-500 font-medium">
          Published {post.data.publishDate.toLocaleDateString('en-US', {
            month: 'long',
            day: 'numeric',
            year: 'numeric',
          })}
        </span>
        <span class="text-xs text-slate-400 dark:text-slate-500 font-medium">•</span>
        <span class="text-xs text-slate-400 dark:text-slate-500 font-medium">
          {post.data.readingTime}
        </span>
      </div>

      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-[1.15] mb-6">
        {post.data.title}
      </h1>

      <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-300 leading-relaxed font-normal mb-8">
        {post.data.description}
      </p>

      {/* Author Strip */}
      <div class="flex items-center gap-3.5 pt-6 border-t border-slate-200/80 dark:border-white/10">
        <div class="w-11 h-11 rounded-full bg-gradient-to-tr from-teal-500 to-emerald-400 text-white flex items-center justify-center font-bold text-sm shadow-md shadow-teal-500/20">
          {post.data.author.substring(0, 2)}
        </div>
        <div>
          <div class="text-sm font-semibold text-slate-900 dark:text-slate-100">
            {post.data.author}
          </div>
          <div class="text-xs text-slate-500 dark:text-slate-400">
            {post.data.authorRole} • Verified Engineering Lead
          </div>
        </div>
      </div>
    </header>

    {/* Hero Architectural Visual */}
    <figure class="max-w-5xl mb-12 rounded-3xl overflow-hidden border border-slate-200/80 dark:border-white/10 bg-slate-950 shadow-2xl">
      <img
        src={post.data.heroImage}
        alt={post.data.heroImageAlt}
        class="w-full h-auto object-cover"
        loading="eager"
      />
      <figcaption class="p-3 sm:p-4 text-center text-xs text-slate-400 bg-slate-900/90 border-t border-white/5 font-mono">
        Figure 1: {post.data.heroImageAlt}
      </figcaption>
    </figure>

    {/* GEO / AI Quick Answer Box (Executive Summary) */}
    <aside
      class="max-w-4xl mb-14 rounded-2xl p-6 sm:p-8 bg-teal-500/[0.04] dark:bg-teal-950/20 border border-teal-500/30 dark:border-teal-500/20 shadow-lg shadow-teal-500/5 backdrop-blur-md"
      aria-label="Executive Summary and AI Answer Box"
    >
      <div class="flex items-center gap-2.5 mb-4">
        <div class="w-6 h-6 rounded-lg bg-teal-500 text-white flex items-center justify-center text-xs font-bold shadow-sm shadow-teal-500/30">
          AI
        </div>
        <h2 class="text-sm sm:text-base font-bold text-teal-900 dark:text-teal-300 tracking-wide uppercase font-mono">
          Executive Summary & Architectural Takeaways (GEO Answer Box)
        </h2>
      </div>

      <ul class="space-y-3 mb-6">
        {post.data.tldr.map((bullet) => (
          <li class="flex items-start gap-3 text-sm sm:text-base text-slate-700 dark:text-slate-200 leading-relaxed">
            <span class="text-teal-500 font-bold mt-0.5">•</span>
            <span>{bullet}</span>
          </li>
        ))}
      </ul>

      {/* Key Stats Grid */}
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-teal-500/20">
        {post.data.keyStats.map((stat) => (
          <div class="p-3 rounded-xl bg-white/60 dark:bg-black/30 border border-teal-500/20">
            <div class="text-[11px] text-teal-700 dark:text-teal-400 font-medium">
              {stat.label}
            </div>
            <div class="text-sm sm:text-base font-bold text-slate-900 dark:text-white mt-0.5">
              {stat.value}
            </div>
          </div>
        ))}
      </div>
    </aside>

    {/* Main Two-Column Layout (Article Content + Sticky TOC) */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 max-w-7xl">
      {/* Article Body with Progressive Reading Expander */}
      <div class="lg:col-span-8">
        {/*
          CRITICAL SEO REQUIREMENT:
          100% of the markdown content is server-rendered inside this container.
          Search engines, LLM crawlers, and bots parse the full prose directly.
          Progressive disclosure uses CSS max-height with an aria-expanded toggle.
        */}
        <div id="deep-dive-container" class="relative transition-all duration-500 max-h-[920px] overflow-hidden" aria-expanded="false">
          <article
            id="deep-dive-prose"
            class="prose prose-slate dark:prose-invert max-w-none
              prose-headings:font-display prose-headings:font-bold prose-headings:tracking-tight
              prose-h2:text-2xl sm:prose-h2:text-3xl prose-h2:mt-12 prose-h2:mb-4 prose-h2:border-b prose-h2:border-slate-200/80 dark:prose-h2:border-white/10 prose-h2:pb-3
              prose-h3:text-xl sm:prose-h3:text-2xl prose-h3:mt-8 prose-h3:mb-3
              prose-p:text-slate-700 dark:prose-p:text-slate-300 prose-p:leading-relaxed prose-p:text-base sm:prose-p:text-lg
              prose-a:text-teal-600 dark:prose-a:text-teal-400 prose-a:underline hover:prose-a:text-teal-500
              prose-pre:bg-slate-950 prose-pre:border prose-pre:border-slate-800 prose-pre:rounded-2xl
              prose-code:text-teal-600 dark:prose-code:text-teal-300 prose-code:font-mono prose-code:text-sm
              prose-img:rounded-2xl prose-img:border prose-img:border-slate-200/80 dark:prose-img:border-white/10
              prose-table:border prose-table:border-slate-200 dark:prose-table:border-white/10 prose-th:bg-slate-100 dark:prose-th:bg-white/5"
          >
            <Content />
          </article>

          {/* Fade Gradient Overlay on preview state */}
          <div
            id="fade-gradient-overlay"
            class="absolute bottom-0 left-0 right-0 h-80 bg-gradient-to-t from-[#F8F9FB] via-[#F8F9FB]/90 dark:from-[#07090E] dark:via-[#07090E]/90 to-transparent flex items-end justify-center pb-8 pointer-events-auto transition-opacity duration-300"
          >
            <button
              type="button"
              id="expand-deep-dive-btn"
              class="px-8 py-3.5 rounded-2xl bg-teal-500 text-white font-semibold text-sm sm:text-base shadow-xl shadow-teal-500/25 hover:bg-teal-600 hover:shadow-teal-500/40 transform hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center gap-2 cursor-pointer"
            >
              <span>Expand Full Deep-Dive Analysis ({post.data.readingTime})</span>
              <svg class="w-4 h-4 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>
        </div>

        {/* Interactive Technical FAQs Section */}
        <section class="mt-16 pt-12 border-t border-slate-200/80 dark:border-white/10" aria-label="Frequently Asked Questions">
          <div class="flex items-center gap-2.5 mb-3">
            <span class="w-2 h-2 rounded-full bg-teal-500"></span>
            <span class="text-xs font-semibold uppercase tracking-wider text-teal-600 dark:text-teal-400 font-mono">
              Technical Verification
            </span>
          </div>
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white mb-6">
            Frequently Asked Questions
          </h2>

          <div class="space-y-4">
            {post.data.faqs.map((faq, index) => (
              <details
                class="group rounded-2xl bg-white/70 dark:bg-white/[0.03] border border-slate-200/80 dark:border-white/10 p-5 transition-all duration-200 hover:border-teal-500/30 open:bg-teal-500/[0.02] open:border-teal-500/40"
              >
                <summary class="flex items-center justify-between font-semibold text-base sm:text-lg text-slate-900 dark:text-slate-100 cursor-pointer list-none focus:outline-none">
                  <span>{faq.question}</span>
                  <span class="ml-4 w-7 h-7 rounded-lg bg-slate-100 dark:bg-white/5 flex items-center justify-center text-slate-500 dark:text-slate-400 group-open:rotate-180 transition-transform duration-200 flex-shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                    </svg>
                  </span>
                </summary>
                <p class="mt-4 text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed border-t border-slate-100 dark:border-white/5 pt-3">
                  {faq.answer}
                </p>
              </details>
            ))}
          </div>
        </section>

        {/* Tags */}
        <div class="mt-10 flex flex-wrap items-center gap-2">
          <span class="text-xs text-slate-400 dark:text-slate-500 mr-2 font-mono">Topics:</span>
          {post.data.tags.map((tag) => (
            <span class="px-3 py-1 rounded-lg text-xs font-medium bg-slate-100 dark:bg-white/5 text-slate-600 dark:text-slate-300 border border-slate-200/60 dark:border-white/5">
              #{tag}
            </span>
          ))}
        </div>
      </div>

      {/* Sidebar: Table of Contents & Related Posts */}
      <aside class="lg:col-span-4 space-y-8">
        {/* Sticky Table of Contents Container */}
        <div class="sticky top-28 space-y-8">
          <div class="rounded-3xl p-6 bg-white/70 dark:bg-white/[0.03] border border-slate-200/80 dark:border-white/10 backdrop-blur-xl shadow-lg shadow-slate-200/30 dark:shadow-none">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 font-mono mb-4">
              Article Outline
            </h3>
            <nav id="toc-nav" class="space-y-2 text-sm text-slate-600 dark:text-slate-400">
              {/* Populated dynamically via client script from H2 tags */}
            </nav>
          </div>

          {/* Related Articles Box */}
          <div class="rounded-3xl p-6 bg-white/70 dark:bg-white/[0.03] border border-slate-200/80 dark:border-white/10 backdrop-blur-xl shadow-lg shadow-slate-200/30 dark:shadow-none">
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500 font-mono mb-4">
              Related Deep Dives
            </h3>
            <div class="space-y-5">
              {relatedPosts.map((rPost) => (
                <a href={`/blog/${rPost.slug}`} class="block group">
                  <div class="text-[11px] font-semibold uppercase tracking-wider text-teal-600 dark:text-teal-400 mb-1">
                    {rPost.data.category}
                  </div>
                  <h4 class="text-sm font-bold text-slate-900 dark:text-slate-200 group-hover:text-teal-500 dark:group-hover:text-teal-400 transition-colors line-clamp-2">
                    {rPost.data.title}
                  </h4>
                  <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 line-clamp-2">
                    {rPost.data.description}
                  </p>
                </a>
              ))}
            </div>
          </div>

          {/* Quick Pilot Request CTA Box */}
          <div class="rounded-3xl p-6 bg-gradient-to-br from-teal-500/10 via-emerald-500/5 to-transparent border border-teal-500/30 backdrop-blur-xl">
            <h4 class="text-base font-bold text-slate-900 dark:text-white mb-2">
              Deploy Colformly on Your Campus
            </h4>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mb-4">
              Eliminate answer-key leaks, stop Google Sheets 429 errors, and preserve 100% faculty Google Drive ownership.
            </p>
            <a
              href="/#pilot-demo"
              class="block w-full py-2.5 px-4 rounded-xl bg-teal-500 hover:bg-teal-600 text-white font-semibold text-xs text-center transition-all shadow-md shadow-teal-500/20"
            >
              Request Free Campus Pilot →
            </a>
          </div>
        </div>
      </aside>
    </div>

    {/* Bottom Institutional Call-to-Action Banner */}
    <section class="mt-20 rounded-3xl p-8 sm:p-12 lg:p-16 bg-gradient-to-tr from-slate-900 via-slate-950 to-teal-950 text-white border border-teal-500/30 shadow-2xl relative overflow-hidden">
      <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-teal-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
      <div class="max-w-3xl relative z-10">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-teal-500/20 border border-teal-500/30 text-teal-300 text-xs font-semibold uppercase tracking-wider mb-4">
          Open Architecture • Zero Vendor Lock-In
        </span>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight mb-4">
          Ready to Run Infinite-Scale, Cheat-Proof Exams?
        </h2>
        <p class="text-slate-300 text-base sm:text-lg mb-8 leading-relaxed">
          Join leading polytechnics, engineering colleges, and universities modernizing their examinations with Colformly’s server-side edge grading.
        </p>
        <div class="flex flex-wrap items-center gap-4">
          <a
            href="/#pilot-demo"
            class="px-8 py-3.5 rounded-2xl bg-teal-500 hover:bg-teal-400 text-slate-950 font-bold text-sm sm:text-base transition-all shadow-xl shadow-teal-500/25"
          >
            Launch Free Campus Pilot
          </a>
          <a
            href="/blog"
            class="px-6 py-3.5 rounded-2xl bg-white/10 hover:bg-white/20 text-white font-medium text-sm sm:text-base transition-all border border-white/10"
          >
            Browse All Engineering Logs
          </a>
        </div>
      </div>
    </section>
  </main>

  {/* Client-Side Expander, TOC & Progress Scripts */}
  <script is:inline>
    (function() {
      // 1. Reading Progress Bar
      var progressBar = document.getElementById('reading-progress-bar');
      window.addEventListener('scroll', function() {
        var winScroll = document.body.scrollTop || document.documentElement.scrollTop;
        var height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
        var scrolled = (winScroll / height) * 100;
        if (progressBar) {
          progressBar.style.width = scrolled + '%';
        }
      });

      // 2. Progressive Deep-Dive Expander
      var container = document.getElementById('deep-dive-container');
      var expandBtn = document.getElementById('expand-deep-dive-btn');
      var overlay = document.getElementById('fade-gradient-overlay');

      function expandArticle() {
        if (!container) return;
        container.style.maxHeight = 'none';
        container.setAttribute('aria-expanded', 'true');
        if (overlay) {
          overlay.style.display = 'none';
        }
      }

      if (expandBtn) {
        expandBtn.addEventListener('click', expandArticle);
      }

      // If URL has a hash link (e.g. from TOC), auto-expand
      if (window.location.hash) {
        expandArticle();
      }

      // 3. Dynamic Table of Contents Generation
      var prose = document.getElementById('deep-dive-prose');
      var tocNav = document.getElementById('toc-nav');

      if (prose && tocNav) {
        var headings = prose.querySelectorAll('h2');
        if (headings.length > 0) {
          headings.forEach(function(h2, index) {
            var text = h2.textContent || 'Section ' + (index + 1);
            var id = h2.id;
            if (!id) {
              id = 'section-' + (index + 1);
              h2.id = id;
            }

            var link = document.createElement('a');
            link.href = '#' + id;
            link.className = 'block py-1 px-2 rounded-lg hover:bg-teal-500/10 hover:text-teal-600 dark:hover:text-teal-400 transition-colors truncate';
            link.textContent = text.replace(/^#+\s*/, '');
            link.addEventListener('click', function() {
              expandArticle();
            });
            tocNav.appendChild(link);
          });
        } else {
          tocNav.innerHTML = '<span class="text-xs text-slate-400">Full analysis article</span>';
        }
      }
    })();
  </script>
</Layout>
