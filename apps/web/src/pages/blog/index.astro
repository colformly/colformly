---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
// Sort by publishDate descending
const sortedPosts = posts.sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()
);

const featuredPost = sortedPosts[0];
const remainingPosts = sortedPosts.slice(1);

const categories = [
  'All',
  'Security & Anti-Cheat',
  'Architecture & Scale',
  'Campus Governance',
];

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Colformly Engineering & Governance Journal',
    description:
      'In-depth architectural breakdowns, zero-limit edge scaling, and anti-cheat governance for campus examinations.',
    url: 'https://colformly.pages.dev/blog',
    publisher: {
      '@type': 'Organization',
      name: 'Colformly',
      url: 'https://colformly.pages.dev',
      logo: 'https://colformly.pages.dev/favicon.svg',
    },
    blogPost: sortedPosts.map((post) => ({
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.publishDate.toISOString(),
      url: `https://colformly.pages.dev/blog/${post.slug}`,
      image: post.data.heroImage.startsWith('http')
        ? post.data.heroImage
        : `https://colformly.pages.dev${post.data.heroImage}`,
      author: {
        '@type': 'Organization',
        name: post.data.author,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: sortedPosts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `https://colformly.pages.dev/blog/${post.slug}`,
      name: post.data.title,
    })),
  },
];
---

<Layout
  title="Engineering & Governance Journal — Colformly"
  description="Deep-dive architectural breakdowns, split-plane edge scaling, anti-cheat engineering, and Google Workspace governance for higher education."
  canonical="https://colformly.pages.dev/blog"
  surfaceClass="bg-[#F8F9FB] dark:bg-[#07090E]"
  structuredData={structuredData}
>
  <main class="relative pt-28 md:pt-36 pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto overflow-hidden">
    {/* Ambient Background Glows */}
    <div
      class="fixed top-0 left-1/2 -translate-x-1/2 w-[800px] h-[350px] bg-gradient-to-b from-teal-500/10 via-teal-500/5 to-transparent blur-[140px] rounded-full pointer-events-none -z-10"
      aria-hidden="true"
    ></div>
    <div
      class="fixed top-96 right-1/4 w-[500px] h-[300px] bg-gradient-to-b from-blue-500/10 via-indigo-500/5 to-transparent blur-[120px] rounded-full pointer-events-none -z-10"
      aria-hidden="true"
    ></div>

    {/* Header Section */}
    <div class="max-w-3xl mb-14 md:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-500/10 border border-teal-500/20 text-teal-600 dark:text-teal-400 text-xs font-semibold tracking-wide uppercase mb-5">
        <span class="w-1.5 h-1.5 rounded-full bg-teal-500 animate-pulse"></span>
        Engineering & Campus Governance
      </div>
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-[1.12] mb-6">
        Architecting the Next Era of <span class="text-transparent bg-clip-text bg-gradient-to-r from-teal-500 to-emerald-400">Campus Examinations</span>
      </h1>
      <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-400 leading-relaxed font-normal">
        Deep technical logs on edge-computed grading, zero-limit Google Sheets split-plane scaling, and cryptographic anti-cheat governance for modern universities.
      </p>

      {/* Category Filter Pills */}
      <div class="flex flex-wrap items-center gap-2 mt-8" id="category-filters">
        {categories.map((cat, idx) => (
          <button
            type="button"
            data-category-btn={cat}
            class:list={[
              'px-4 py-2 rounded-xl text-xs sm:text-sm font-medium transition-all duration-200 border cursor-pointer',
              idx === 0
                ? 'bg-teal-500 text-white border-teal-500 shadow-sm shadow-teal-500/20'
                : 'bg-white/80 dark:bg-white/[0.04] text-slate-600 dark:text-slate-300 border-slate-200 dark:border-white/10 hover:border-teal-500/40 hover:text-teal-600 dark:hover:text-teal-400 backdrop-blur-sm',
            ]}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>

    {/* Featured Hero Article */}
    {featuredPost && (
      <article
        data-post-card
        data-post-category={featuredPost.data.category}
        class="mb-14 rounded-3xl p-6 sm:p-8 lg:p-10 bg-white/70 dark:bg-white/[0.03] border border-slate-200/80 dark:border-white/10 shadow-xl shadow-slate-200/40 dark:shadow-none backdrop-blur-xl transition-all duration-300 hover:border-teal-500/40 group"
      >
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <div class="lg:col-span-7 flex flex-col justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-3 mb-4">
                <span class="px-3 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-teal-500/10 text-teal-600 dark:text-teal-400 border border-teal-500/20">
                  {featuredPost.data.category}
                </span>
                <span class="text-xs text-slate-400 dark:text-slate-500 font-medium">
                  {featuredPost.data.publishDate.toLocaleDateString('en-US', {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                  })}
                </span>
                <span class="text-xs text-slate-400 dark:text-slate-500 font-medium">•</span>
                <span class="text-xs text-slate-400 dark:text-slate-500 font-medium">
                  {featuredPost.data.readingTime}
                </span>
                <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                  Featured Deep-Dive
                </span>
              </div>

              <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900 dark:text-white leading-tight mb-4 group-hover:text-teal-500 dark:group-hover:text-teal-400 transition-colors">
                <a href={`/blog/${featuredPost.slug}`} class="focus:outline-none">
                  {featuredPost.data.title}
                </a>
              </h2>

              <p class="text-slate-600 dark:text-slate-400 text-base sm:text-lg leading-relaxed mb-6 line-clamp-3">
                {featuredPost.data.description}
              </p>

              {/* Key Stats Chips */}
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-8">
                {featuredPost.data.keyStats.map((stat) => (
                  <div class="p-2.5 rounded-xl bg-slate-50 dark:bg-white/[0.02] border border-slate-200/60 dark:border-white/5">
                    <div class="text-[11px] text-slate-500 dark:text-slate-400 font-medium truncate">
                      {stat.label}
                    </div>
                    <div class="text-xs sm:text-sm font-semibold text-slate-900 dark:text-slate-200 mt-0.5">
                      {stat.value}
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-slate-100 dark:border-white/5">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-full bg-teal-500/20 text-teal-600 dark:text-teal-400 flex items-center justify-center font-bold text-xs uppercase">
                  {featuredPost.data.author.substring(0, 2)}
                </div>
                <div>
                  <div class="text-xs font-semibold text-slate-900 dark:text-slate-200">
                    {featuredPost.data.author}
                  </div>
                  <div class="text-[11px] text-slate-500 dark:text-slate-400">
                    {featuredPost.data.authorRole}
                  </div>
                </div>
              </div>

              <a
                href={`/blog/${featuredPost.slug}`}
                class="inline-flex items-center gap-2 text-sm font-semibold text-teal-600 dark:text-teal-400 hover:text-teal-500 group-hover:translate-x-1 transition-all"
              >
                Read Deep-Dive Analysis
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>

          <div class="lg:col-span-5">
            <a href={`/blog/${featuredPost.slug}`} class="block overflow-hidden rounded-2xl border border-slate-200/80 dark:border-white/10 bg-slate-950 shadow-inner group/img">
              <img
                src={featuredPost.data.heroImage}
                alt={featuredPost.data.heroImageAlt}
                class="w-full h-auto object-cover transform group-hover/img:scale-105 transition-transform duration-500"
                loading="eager"
              />
            </a>
          </div>
        </div>
      </article>
    )}

    {/* Grid of Remaining Articles */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="articles-grid">
      {remainingPosts.map((post) => (
        <article
          data-post-card
          data-post-category={post.data.category}
          class="flex flex-col justify-between rounded-3xl p-6 sm:p-8 bg-white/70 dark:bg-white/[0.03] border border-slate-200/80 dark:border-white/10 shadow-lg shadow-slate-200/30 dark:shadow-none backdrop-blur-xl transition-all duration-300 hover:border-teal-500/40 hover:-translate-y-1 group"
        >
          <div>
            <a href={`/blog/${post.slug}`} class="block overflow-hidden rounded-2xl border border-slate-200/80 dark:border-white/10 bg-slate-950 mb-6 group/img">
              <img
                src={post.data.heroImage}
                alt={post.data.heroImageAlt}
                class="w-full h-48 sm:h-56 object-cover transform group-hover/img:scale-105 transition-transform duration-500"
                loading="lazy"
              />
            </a>

            <div class="flex flex-wrap items-center gap-3 mb-3">
              <span class="px-2.5 py-1 rounded-full text-xs font-semibold uppercase tracking-wider bg-teal-500/10 text-teal-600 dark:text-teal-400 border border-teal-500/20">
                {post.data.category}
              </span>
              <span class="text-xs text-slate-400 dark:text-slate-500 font-medium">
                {post.data.publishDate.toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                })}
              </span>
              <span class="text-xs text-slate-400 dark:text-slate-500 font-medium">•</span>
              <span class="text-xs text-slate-400 dark:text-slate-500 font-medium">
                {post.data.readingTime}
              </span>
            </div>

            <h3 class="font-display text-xl sm:text-2xl font-bold text-slate-900 dark:text-white leading-tight mb-3 group-hover:text-teal-500 dark:group-hover:text-teal-400 transition-colors">
              <a href={`/blog/${post.slug}`}>
                {post.data.title}
              </a>
            </h3>

            <p class="text-slate-600 dark:text-slate-400 text-sm sm:text-base leading-relaxed mb-6 line-clamp-3">
              {post.data.description}
            </p>

            {/* Key Stats Grid */}
            <div class="grid grid-cols-2 gap-2 mb-6">
              {post.data.keyStats.slice(0, 2).map((stat) => (
                <div class="p-2 rounded-xl bg-slate-50 dark:bg-white/[0.02] border border-slate-200/60 dark:border-white/5">
                  <div class="text-[10px] text-slate-500 dark:text-slate-400 font-medium truncate">
                    {stat.label}
                  </div>
                  <div class="text-xs font-semibold text-slate-900 dark:text-slate-200 mt-0.5">
                    {stat.value}
                  </div>
                </div>
              ))}
            </div>
          </div>

          <div class="flex items-center justify-between pt-4 border-t border-slate-100 dark:border-white/5 mt-auto">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-full bg-teal-500/20 text-teal-600 dark:text-teal-400 flex items-center justify-center font-bold text-xs uppercase">
                {post.data.author.substring(0, 2)}
              </div>
              <span class="text-xs font-semibold text-slate-800 dark:text-slate-300">
                {post.data.author}
              </span>
            </div>

            <a
              href={`/blog/${post.slug}`}
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-teal-600 dark:text-teal-400 hover:text-teal-500 group-hover:translate-x-1 transition-all"
            >
              Read Article
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>

    {/* Zero State fallback for filtering */}
    <div id="no-articles-match" class="hidden text-center py-20">
      <div class="w-16 h-16 mx-auto mb-4 rounded-2xl bg-slate-100 dark:bg-white/5 flex items-center justify-center text-slate-400">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <h3 class="text-lg font-bold text-slate-900 dark:text-white">No articles found</h3>
      <p class="text-sm text-slate-500 dark:text-slate-400 mt-1">
        Try selecting a different category filter above.
      </p>
    </div>
  </main>

  {/* Client-Side Category Filter Script */}
  <script is:inline>
    (function() {
      const buttons = document.querySelectorAll('[data-category-btn]');
      const cards = document.querySelectorAll('[data-post-card]');
      const noMatchNotice = document.getElementById('no-articles-match');

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const selected = btn.getAttribute('data-category-btn');

          // Update active button state
          buttons.forEach(b => {
            b.classList.remove('bg-teal-500', 'text-white', 'border-teal-500', 'shadow-sm', 'shadow-teal-500/20');
            b.classList.add('bg-white/80', 'dark:bg-white/[0.04]', 'text-slate-600', 'dark:text-slate-300', 'border-slate-200', 'dark:border-white/10');
          });
          btn.classList.add('bg-teal-500', 'text-white', 'border-teal-500', 'shadow-sm', 'shadow-teal-500/20');
          btn.classList.remove('bg-white/80', 'dark:bg-white/[0.04]', 'text-slate-600', 'dark:text-slate-300', 'border-slate-200', 'dark:border-white/10');

          let visibleCount = 0;
          cards.forEach(card => {
            const cardCat = card.getAttribute('data-post-category');
            if (selected === 'All' || cardCat === selected) {
              card.style.display = '';
              visibleCount++;
            } else {
              card.style.display = 'none';
            }
          });

          if (noMatchNotice) {
            noMatchNotice.style.display = visibleCount === 0 ? 'block' : 'none';
          }
        });
      });
    })();
  </script>
</Layout>
