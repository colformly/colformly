---
return Astro.redirect('https://colformly-super-admin.edgecors.com', 301);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0;url=https://colformly-super-admin.edgecors.com" />
    <title>Redirecting to Super Admin — Colformly</title>
    <script is:inline>
      window.location.replace('https://colformly-super-admin.edgecors.com');
    </script>
  </head>
  <body class="bg-slate-900 text-white font-sans flex items-center justify-center min-h-screen">
    <p class="text-sm">Redirecting to Super Admin (<a class="underline text-teal-400" href="https://colformly-super-admin.edgecors.com">colformly-super-admin.edgecors.com</a>)...</p>
  </body>
</html>
