---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/landing/HeroSection';
import MetricsStrip from '../components/landing/MetricsStrip';
import ChaosVsCalm from '../components/landing/ChaosVsCalm';
import HorizontalScrollStage from '../components/landing/HorizontalScrollStage';
import ArchitectureSection from '../components/landing/ArchitectureSection';
import SecurityBento from '../components/landing/SecurityBento';
import TeacherWorkflow from '../components/landing/TeacherWorkflow';
import AudienceSelector from '../components/landing/AudienceSelector';
import PricingSection from '../components/landing/PricingSection';
import ContactForm from '../components/ContactForm';
import { Mail, Clock, ShieldCheck, Sparkles } from 'lucide-react';
---

<Layout>
  <main class="relative overflow-hidden">
    <!-- SECTION 1: HERO -->
    <HeroSection client:load />

    <!-- SECTION 2: METRICS & PULSE STRIP -->
    <MetricsStrip client:visible />

    <!-- SECTION 3: CHAOS VS CALM PARALLAX SPLIT -->
    <ChaosVsCalm client:visible />

    <!-- SECTION 4: HORIZONTAL SCROLL STAGE ("ONE PLATFORM, FOUR WORLDS") -->
    <div id="features">
      <HorizontalScrollStage client:visible />
    </div>

    <!-- SECTION 5: THE ZERO-LIMIT SPLIT-PLANE ARCHITECTURE -->
    <ArchitectureSection client:visible />

    <!-- SECTION 6: THE SECURITY & ANTI-CHEAT BENTO GRID -->
    <SecurityBento client:visible />

    <!-- SECTION 7: TEACHER WORKFLOW IN 3 CLICKS -->
    <TeacherWorkflow client:visible />

    <!-- SECTION 8: BUILT FOR EVERY CAMPUS ECOSYSTEM -->
    <AudienceSelector client:visible />

    <!-- SECTION 9: INSTITUTIONAL PLANS & PREDICTABLE SCALE -->
    <PricingSection client:visible />

    <!-- SECTION 10: LIVE PILOT DEMO CTA -->
    <section class="py-24 px-4 sm:px-6 max-w-7xl mx-auto border-t border-slate-200/80 dark:border-white/10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left Explanatory Pitch -->
        <div class="lg:col-span-5 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-teal-500/10 border border-teal-500/20 text-teal-600 dark:text-teal-400 text-xs font-mono font-bold">
            <Sparkles class="w-3.5 h-3.5" />
            <span>Dedicated Campus Onboarding</span>
          </div>

          <h2 class="font-display font-black text-3xl sm:text-5xl text-slate-900 dark:text-white tracking-tight">
            Deploy a Free 60-Day Pilot for Your Department
          </h2>

          <p class="font-body text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
            See how easy it is to eliminate spreadsheet rate limits and answer leaks. Our engineering team
            provisions your dedicated Google Workspace domain gate, configures your faculty rosters, and
            supports your first live midterm at zero risk.
          </p>

          <div class="space-y-3 pt-2 text-xs sm:text-sm text-slate-700 dark:text-slate-300 font-mono">
            <div class="flex items-center gap-2.5">
              <Clock class="w-4 h-4 text-teal-600 dark:text-teal-400 shrink-0" />
              <span>4 Business Hours Pilot Provisioning Guarantee</span>
            </div>
            <div class="flex items-center gap-2.5">
              <ShieldCheck class="w-4 h-4 text-teal-600 dark:text-teal-400 shrink-0" />
              <span>Zero Credit Card Required • Full Feature Access</span>
            </div>
            <div class="flex items-center gap-2.5">
              <Mail class="w-4 h-4 text-teal-600 dark:text-teal-400 shrink-0" />
              <span>Direct Founder Support: support@edgecors.com</span>
            </div>
          </div>
        </div>

        <!-- Right Embedded Contact Form -->
        <div class="lg:col-span-7">
          <ContactForm client:visible />
        </div>
      </div>
    </section>
  </main>
</Layout>
