---
import Layout from '../layouts/Layout.astro';

const tiers = [
  {
    name: 'Department Pilot',
    badge: 'Zero-Cost Forever',
    price: '₹0',
    period: '/ semester',
    desc: 'Perfect for a single department (like CSE or ECE) running real anti-cheat mid-sem assessments.',
    cta: 'Launch Free Pilot',
    href: '/contact',
    featured: false,
    items: [
      'Up to 300 active students',
      'Full Anti-Cheat Lockdown (Tab + Fullscreen)',
      'Instant SVG Paper Grading & Topic Autopsy',
      'BYOS Supabase & Cloudflare Worker Support',
      'Google Workspace OAuth Sign-In',
    ],
  },
  {
    name: 'Flat Campus License',
    badge: 'Most Popular • Unlimited Seats',
    price: '₹14,999',
    period: '/ semester flat',
    desc: 'One predictable flat campus fee covering every branch, year, section, faculty member, and student.',
    cta: 'Claim Flat Campus License',
    href: '/contact',
    featured: true,
    items: [
      'Unlimited students, faculty & concurrent exams',
      'Custom Structural Branding (Colors, Logo, Layout)',
      'CSV Bulk Roster Dropzone + Course > Year > Section',
      'Notion-Style Test Studio + AI Question Generator',
      'Student Gamified Leaderboards & BYOC AI Tutor',
      'Priority Founder Engineering Onboarding (< 24h)',
    ],
  },
  {
    name: 'University Group',
    badge: 'Multi-Campus Enterprise',
    price: 'Custom',
    period: '/ annual SLA',
    desc: 'For multi-college trusts and autonomous universities needing unified super-admin governance.',
    cta: 'Talk to Founders',
    href: '/contact',
    featured: false,
    items: [
      'Multiple isolated college tenants (strict org_id RLS)',
      'Dedicated BYOS infrastructure audit & setup',
      'Custom domain (exams.youruniversity.edu.in)',
      'ERP / SIS Gradebook Webhook Integrations',
      '99.99% Uptime SLA & Exam-Day War Room Support',
    ],
  },
];
---

<Layout
  title="Flat Campus License Pricing"
  description="Transparent Flat Campus License pricing with zero per-student surcharges."
  surfaceClass="bg-light-surface-variant"
>
  <main class="relative pt-28 md:pt-36 pb-20 px-6 max-w-6xl mx-auto flex flex-col gap-16">
    <div
      class="fixed top-0 left-1/2 -translate-x-1/2 w-[820px] h-[300px] bg-teal-100/35 blur-[120px] rounded-full pointer-events-none -z-10"
    >
    </div>

    <!-- Header -->
    <header class="text-center max-w-3xl mx-auto space-y-4">
      <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-teal-50 border border-teal-200 text-light-primary font-label text-xs font-bold">
        Zero Per-Student Surprises
      </span>
      <h1 class="font-headline font-extrabold text-4xl sm:text-5xl text-slate-900 tracking-tight">
        Simple, Flat Campus Licensing
      </h1>
      <p class="font-body text-lg text-slate-600">
        Because our BYOS + Edge architecture runs at near-zero infrastructure cost, we pass 100% of
        the savings directly to your college.
      </p>
    </header>

    <!-- 3 Pricing Cards -->
    <section class="grid grid-cols-1 lg:grid-cols-3 gap-7 items-stretch">
      {tiers.map((tier) => (
        <article
          class:list={[
            'rounded-3xl p-8 flex flex-col justify-between gap-7 transition-all',
            tier.featured
              ? 'bg-white border-2 border-light-primary shadow-floating-mockup relative'
              : 'bg-white border border-slate-200/90 shadow-card-soft hover:shadow-card-hover',
          ]}
        >
          <div class="space-y-5">
            <div class="flex items-center justify-between gap-2">
              <span
                class:list={[
                  'px-3 py-1 rounded-full font-label text-[11px] font-bold border',
                  tier.featured
                    ? 'bg-teal-soft text-light-on-primary-container border-teal-300'
                    : 'bg-slate-50 text-slate-600 border-slate-200',
                ]}
              >
                {tier.badge}
              </span>
            </div>

            <div>
              <h2 class="font-headline font-bold text-2xl text-slate-900">{tier.name}</h2>
              <div class="mt-3 flex items-baseline gap-1.5">
                <span class="font-headline font-extrabold text-4xl text-slate-900 tracking-tight">
                  {tier.price}
                </span>
                <span class="text-sm text-slate-500 font-medium">{tier.period}</span>
              </div>
              <p class="text-sm text-slate-600 mt-3 leading-relaxed">{tier.desc}</p>
            </div>

            <ul class="space-y-3 pt-4 border-t border-slate-100">
              {tier.items.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-slate-700">
                  <span class="w-5 h-5 rounded-full bg-teal-50 text-light-primary border border-teal-200 flex items-center justify-center text-xs font-bold shrink-0 mt-0.5">
                    ✓
                  </span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <a
            href={tier.href}
            class:list={[
              'w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full font-label text-sm font-bold transition-all',
              tier.featured
                ? 'bg-light-primary hover:bg-[#0D655E] text-white shadow-sm hover:-translate-y-0.5'
                : 'bg-slate-900 hover:bg-slate-800 text-white',
            ]}
          >
            <span>{tier.cta}</span>
            <span>→</span>
          </a>
        </article>
      ))}
    </section>

    <!-- Pricing Guarantee Note -->
    <section class="rounded-3xl bg-white border border-slate-200/90 p-7 sm:p-9 flex flex-col md:flex-row items-center justify-between gap-6">
      <div class="space-y-1.5">
        <h3 class="font-headline font-bold text-xl text-slate-900">
          Need procurement paperwork or a live exam cell pilot first?
        </h3>
        <p class="text-sm text-slate-600">
          Run your first mid-sem assessment completely free on the Department Pilot before approving
          the Flat Campus License.
        </p>
      </div>
      <a
        href="/contact"
        class="shrink-0 px-7 py-3 rounded-full bg-teal-50 hover:bg-teal-100 border border-teal-200 text-light-primary font-label text-sm font-bold transition-colors"
      >
        Schedule Procurement Walkthrough →
      </a>
    </section>
  </main>
</Layout>
