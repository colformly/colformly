---
import Layout from '../layouts/Layout.astro';
import BlogJournal from '../components/BlogJournal';
---

<Layout
  title="Colformly Journal — Engineering & Founder Logs"
  description="Building zero-cost, cheat-proof EdTech in public. Architecture logs, campus case studies, and Supabase/Cloudflare deep dives."
  surfaceClass="bg-light-surface-variant"
>
  <main class="relative pt-28 md:pt-36 pb-20 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
    <div
      class="fixed top-0 left-1/2 -translate-x-1/2 w-[800px] h-[300px] bg-teal-100/40 blur-[120px] rounded-full pointer-events-none -z-10"
    >
    </div>

    <BlogJournal client:load />
  </main>
</Layout>
