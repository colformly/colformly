---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  surfaceClass?: string;
}

const {
  title,
  description = 'Colformly — Zero-cost, cheat-proof B2B EdTech assessment & instant grading platform for colleges.',
  surfaceClass = 'bg-light-surface',
} = Astro.props;

const currentPath = Astro.url.pathname;
const gaId = import.meta.env.VITE_GA_MEASUREMENT_ID;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://*.supabase.co https://lh3.googleusercontent.com https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.workers.dev https://*.onrender.com https://colformly-ga4.onrender.com https://colformly-ga4-service.onrender.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; base-uri 'self'; form-action 'self'; object-src 'none';"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Red+Hat+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <title>{title} | Colformly</title>

    {gaId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
        <script is:inline define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', gaId, { send_page_view: true });
        </script>
      </>
    )}
  </head>
  <body
    class:list={[
      surfaceClass,
      'text-light-on-surface font-body antialiased min-h-screen flex flex-col selection:bg-teal-soft selection:text-light-primary',
    ]}
  >
    <Navbar currentPath={currentPath} />
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
    <script is:inline>
      (function() {
        var workerUrl = 'https://colformly-worker.colformly.workers.dev';
        window.addEventListener('error', function(event) {
          try {
            fetch(workerUrl + '/api/telemetry/report', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                source: 'web',
                severity: 'CRITICAL',
                category: 'WORKER_CRASH',
                message: event.message || 'Unhandled window error in web app',
                stack: (event.error && event.error.stack) ? event.error.stack : (event.filename + ':' + event.lineno + ':' + event.colno),
                url: window.location.href,
                timestamp: new Date().toISOString()
              })
            }).catch(function() {});
          } catch (e) {}
        });

        window.addEventListener('unhandledrejection', function(event) {
          try {
            var reason = event.reason || {};
            fetch(workerUrl + '/api/telemetry/report', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                source: 'web',
                severity: 'CRITICAL',
                category: 'WORKER_CRASH',
                message: reason.message || String(reason) || 'Unhandled Promise Rejection in web app',
                stack: reason.stack || '',
                url: window.location.href,
                timestamp: new Date().toISOString()
              })
            }).catch(function() {});
          } catch (e) {}
        });
      })();
    </script>
  </body>
</html>
