---
import ThemeToggle from './ThemeToggle';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isHome = currentPath === '/';

const navLinks = [
  { href: isHome ? '#features' : '/#features', label: 'Features' },
  { href: isHome ? '#pricing' : '/#pricing', label: 'Pricing' },
  { href: '/privacy', label: 'Privacy' },
  { href: '/terms', label: 'Terms' },
];
---

<!-- FLOATING DETACHED PILL GLASSMORPHISM NAVBAR (DESKTOP) -->
<header class="fixed top-5 inset-x-0 z-50 hidden md:flex justify-center px-4 pointer-events-none">
  <nav
    aria-label="Main Navigation"
    class="pointer-events-auto w-full max-w-5xl px-5 py-2.5 rounded-full bg-white/80 dark:bg-[#0D111A]/80 backdrop-blur-xl border border-slate-200/80 dark:border-white/10 shadow-floating-nav flex items-center justify-between transition-all duration-300 hover:shadow-2xl"
  >
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-9 h-9 rounded-full bg-teal-600 text-white flex items-center justify-center font-display font-extrabold text-sm shadow-sm group-hover:scale-105 transition-transform border border-teal-400/30">
        C
      </div>
      <span class="font-display font-bold text-lg tracking-tight text-slate-900 dark:text-white">
        Colformly
      </span>
    </a>

    <!-- Center Links -->
    <ul class="flex items-center gap-6">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="font-display text-sm font-semibold text-slate-600 dark:text-slate-300 hover:text-teal-600 dark:hover:text-teal-400 transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Actions: Theme Toggle, Sign In, Book Pilot -->
    <div class="flex items-center gap-3">
      <ThemeToggle client:load />

      <a
        href="/login"
        class="font-display text-sm font-semibold text-slate-700 dark:text-slate-200 hover:text-teal-600 dark:hover:text-teal-400 px-3 py-1.5 transition-colors"
      >
        Sign In
      </a>

      <a
        href="/#pilot-demo"
        class="inline-flex items-center justify-center gap-1.5 px-5 py-2 rounded-full bg-teal-600 hover:bg-teal-700 text-white font-display text-sm font-bold shadow-md transition-all hover:-translate-y-0.5 active:scale-95"
      >
        <span>Book Pilot</span>
      </a>
    </div>
  </nav>
</header>

<!-- MOBILE TOP BRAND BAR -->
<header class="md:hidden fixed top-4 inset-x-4 z-40 pointer-events-none">
  <div class="pointer-events-auto flex items-center justify-between px-4 py-2.5 rounded-full bg-white/85 dark:bg-[#0D111A]/85 backdrop-blur-xl border border-slate-200/80 dark:border-white/10 shadow-lg">
    <a href="/" class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-full bg-teal-600 text-white flex items-center justify-center font-display font-bold text-xs border border-teal-400/30">
        C
      </div>
      <span class="font-display font-bold text-base text-slate-900 dark:text-white">Colformly</span>
    </a>

    <div class="flex items-center gap-2">
      <ThemeToggle client:load />
      <a
        href="/login"
        class="px-3.5 py-1.5 rounded-full bg-teal-600 text-white font-display text-xs font-bold shadow-sm"
      >
        Sign In
      </a>
    </div>
  </div>
</header>
