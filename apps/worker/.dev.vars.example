# Multi-Key Pool Rotation (comma-separated list for load-spreading & failover):
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
GEMINI_API_KEYS=AIzaSy_key1,AIzaSy_key2,AIzaSy_key3

# Backward-Compatible Fallback Keys (used if plural pool vars are empty):
