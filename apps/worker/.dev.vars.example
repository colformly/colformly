GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Supabase Credentials:
SUPABASE_URL=https://crprffwlfngyiyztwgwb.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_t9dfV3HzxY50ZwkiumiD_w_RurnQuC4
# Legacy fallback:
