# ═══════════════════════════════════════════════════════════════
# Colformly — Environment Variables
# Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════

# Supabase (Publishable on frontends, Secret Key on Cloudflare Worker)
VITE_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
# Legacy fallback:
VITE_SUPABASE_ANON_KEY=your-anon-key
PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
# Legacy fallback:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare Workers
VITE_CLOUDFLARE_WORKER_URL=https://your-worker.your-subdomain.workers.dev
PUBLIC_CLOUDFLARE_WORKER_URL=https://your-worker.your-subdomain.workers.dev

# Subdomain Routing
VITE_ORG_PORTAL_URL=https://colformly-org.edgecors.com
PUBLIC_ORG_PORTAL_URL=https://colformly-org.edgecors.com
VITE_SUPER_ADMIN_URL=https://colformly-super-admin.edgecors.com
PUBLIC_SUPER_ADMIN_URL=https://colformly-super-admin.edgecors.com

# Render GA4 Analytics Microservice
VITE_GA4_SERVICE_URL=https://colformly-ga4-service.onrender.com

# Google Analytics 4 (Optional)
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
